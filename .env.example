KIMI_BIN=
LARK_RUN=
# 單次測試覆寫（會蓋過 configs）
LARK_PROFILE=
CHAT_ID=
POLL_INTERVAL_MS=

# Telegram 日志镜像（单向 agent→telegram；只在 serve 时生效，详见 src/core/telegram.ts）
# 两个都填了才启用；用 `pnpm agent tg-test` 验证连接
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 推送到 Telegram 的日志档位（debug/info/warn/error，独立于本地 LOG_LEVEL；默认 info）
TELEGRAM_LOG_LEVEL=debug
# 批量冲刷间隔毫秒（默认 3000，最低 1000，用于限频）
TELEGRAM_FLUSH_MS=3000
# 运维提醒（如 user token 到期）的目标会话；留空则回退到 TELEGRAM_CHAT_ID。用 `pnpm agent token-check --test` 验证
TELEGRAM_ALERT_CHAT_ID=
