KIMI_BIN=
LARK_RUN=
# 單次測試覆寫（會蓋過 configs）
LARK_PROFILE=
CHAT_ID=
POLL_INTERVAL_MS=

# Telegram 日志镜像（单向 agent→telegram；只在 serve 时生效，详见 src/core/telegram.ts）
# 两个都填了才启用；用 `pnpm agent tg-test` 验证连接
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 推送到 Telegram 的日志档位（debug/info/warn/error，独立于本地 LOG_LEVEL；默认 info）
TELEGRAM_LOG_LEVEL=debug
# 批量冲刷间隔毫秒（默认 3000，最低 1000，用于限频）
TELEGRAM_FLUSH_MS=3000
# 运维提醒（如 user token 到期）的目标会话；留空则回退到 TELEGRAM_CHAT_ID。用 `pnpm agent token-check --test` 验证
TELEGRAM_ALERT_CHAT_ID=

# PostgreSQL 迁移（tudigong + shared LP 经济；留空则对应功能维持 SQLite，见 db.ts soulUsesPg()）
AGENT_PG_URL=
AGENT_PG_POOL_MAX=5
# PG 可观测性阈值（毫秒）：慢查询 / 长交易超过阈值时打 WARN 日志
AGENT_PG_SLOW_QUERY_MS=2000
AGENT_PG_SLOW_TX_MS=30000
# PG 故障边界（毫秒，设 0 关闭该项）：跨 WAN 访问时一次丢包会被 TCP 退避放大成几十秒的卡死，
# 这三个值让它快速失败而不是挂着不放连接。statement_timeout 由 AGENT_PG_STATEMENT_TIMEOUT_MS
# 下发到服务端，客户端 query_timeout 自动取该值 +2s，好让服务端先取消、调用方拿到真实报错。
AGENT_PG_CONNECT_TIMEOUT_MS=8000
AGENT_PG_STATEMENT_TIMEOUT_MS=15000
AGENT_PG_IDLE_TIMEOUT_MS=60000
