{
  "name": "polis-game",
  "version": "0.0.1",
  "description": "城邦土地神：结合 kimi-cli（大脑）与 lark-cli（飞书 user/bot 身份）的常驻 agent 框架，监听 SeeDAO 数字城邦内部群、全量采集消息、被触发才以指定身份回应",
  "type": "module",
  "packageManager": "pnpm@9.12.2",
  "bin": {
    "agent": "dist/bin/agent.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/bin/agent.ts",
    "agent": "node dist/bin/agent.js",
    "cli": "node dist/bin/agent.js cli",
    "cli:dev": "tsx src/bin/agent.ts cli",
    "serve": "node dist/bin/agent.js serve",
    "update": "node dist/bin/agent.js update",
    "mcp": "node dist/tools/mcp-server.js",
    "mcp:dev": "tsx src/tools/mcp-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@napi-rs/canvas": "^1.0.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
