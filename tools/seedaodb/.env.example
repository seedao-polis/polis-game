# seedaodb environment configuration.
# Copy this file to `.env` in the same directory and fill in real values.
# This crate is fully self-contained: it never reads the host project's root `.env`.

# TCP port to listen on.
SEEDAODB_PORT=8878

# Address to bind to. 0.0.0.0 exposes the service beyond localhost -- put it behind a firewall
# and/or a TLS-terminating reverse proxy before doing that in a real deployment (see README).
SEEDAODB_BIND_ADDR=0.0.0.0

# Coarse service-to-service gate checked on every endpoint except /health. Required:
# if this is unset, all protected endpoints reject every request (fail closed), they do not
# fall back to "no gate". Send it as `Authorization: Bearer <token>` or `X-Service-Token: <token>`.
SEEDAODB_SERVICE_TOKEN=

# Selects which IdentityVerifier resolves the caller's open_id from the
# `X-Feishu-User-Token` header: "feishu" calls the real Feishu OpenAPI, "static" looks the
# token up in a local file (SEEDAODB_STATIC_TOKENS_FILE) with no network access. Use "static"
# for local development and CI; use "feishu" in production.
SEEDAODB_AUTH_MODE=feishu

# Feishu app credentials, required when SEEDAODB_AUTH_MODE=feishu. Used to fetch a
# tenant_access_token and to validate caller-supplied user access tokens via
# GET /open-apis/authen/v1/user_info.
SEEDAODB_FEISHU_APP_ID=
SEEDAODB_FEISHU_APP_SECRET=

# Feishu OpenAPI base URL. Override for the international (Lark) site if needed.
SEEDAODB_FEISHU_BASE_URL=https://open.feishu.cn

# Path (relative to this directory unless absolute) to the static token -> open_id table used
# when SEEDAODB_AUTH_MODE=static. See config/static-tokens.toml.example.
SEEDAODB_STATIC_TOKENS_FILE=config/static-tokens.toml

# Path to the named-datasource registry. See config/datasources.toml.example.
SEEDAODB_DATASOURCES_FILE=config/datasources.toml

# Path to the RBAC role/user table. See config/acl.toml.example. A missing or invalid file is a
# hard startup failure -- this service never starts with an empty, all-permissive ACL.
SEEDAODB_ACL_FILE=config/acl.toml

# How long a verified `X-Feishu-User-Token` -> open_id mapping is cached, in seconds. Keeps this
# service from hammering Feishu (and hitting its rate limits) on every request. Should not
# exceed the real lifetime of a Feishu user access token.
SEEDAODB_TOKEN_CACHE_TTL_S=300

# Maximum number of retries when a write hits SQLITE_BUSY/SQLITE_LOCKED (another process, or
# another connection in this service's own pool, is holding the write lock). Uses capped
# exponential backoff between attempts.
SEEDAODB_BUSY_RETRY_MAX=5

# Maximum accepted request body size in bytes, enforced before a handler ever sees the body.
SEEDAODB_MAX_BODY_BYTES=1048576

# Optional: TLS certificate/key paths if this service terminates TLS itself instead of sitting
# behind a reverse proxy. Leave both empty to run plain HTTP (only safe behind a proxy or on a
# fully trusted network -- see README).
SEEDAODB_TLS_CERT=
SEEDAODB_TLS_KEY=

# Path to the append-only audit log. Every /exec call (success or failure) and every denied
# request is written here as one JSON line. Parameter values are never logged, only the SQL
# statement (truncated) and its outcome.
SEEDAODB_AUDIT_LOG=logs/audit.jsonl
