# seedaodb-client environment configuration.
# Copy this file to `.env` in the same directory and fill in real values.
#
# These variables are namespaced under SEEDAODB_CLIENT_ and are read from this directory's own
# `.env` -- they are deliberately separate from the seedaodb server's own SEEDAODB_* variables
# (see tools/seedaodb/.env.example), even though both ultimately point at the same service.

# Base URL of the seedaodb server, after any port mapping/tunneling you have set up.
# Example: http://127.0.0.1:8878
SEEDAODB_CLIENT_BASE_URL=http://127.0.0.1:8878

# Sent as `Authorization: Bearer <token>` on every protected request. Must match the seedaodb
# server's own SEEDAODB_SERVICE_TOKEN.
SEEDAODB_CLIENT_SERVICE_TOKEN=

# "static" or "feishu". "static" requires no network Feishu interaction at all and is the
# recommended way to first verify this client talks to your seedaodb server correctly. "feishu"
# runs a real Feishu user OAuth login -- see README.md's "Feishu mode setup" and "Feishu login
# steps" sections before switching to it.
SEEDAODB_CLIENT_AUTH_MODE=static

# Required when SEEDAODB_CLIENT_AUTH_MODE=static. Must be a token value that is also registered
# in the seedaodb server's own config/static-tokens.toml (see tools/seedaodb/config/static-tokens.toml.example).
SEEDAODB_CLIENT_STATIC_TOKEN=

# Path to the local login-state file this client writes on `login` and clears on `logout`.
# Optional -- defaults to a per-user config directory (%APPDATA%\seedaodb-client\token.json on
# Windows, ~/.config/seedaodb-client/token.json or the platform equivalent elsewhere).
SEEDAODB_CLIENT_TOKEN_FILE=

# Feishu app credentials, required when SEEDAODB_CLIENT_AUTH_MODE=feishu. Create/select an app in
# the Feishu Open Platform developer console and copy its App ID/Secret here. Using the same app
# as the seedaodb server's own SEEDAODB_FEISHU_APP_ID/_APP_SECRET is recommended -- see README.md.
SEEDAODB_CLIENT_FEISHU_APP_ID=
SEEDAODB_CLIENT_FEISHU_APP_SECRET=

# Base URL for the Feishu token exchange/refresh and user_info endpoints. Rarely needs changing;
# overridable mainly for testing against a mock server.
SEEDAODB_CLIENT_FEISHU_TOKEN_BASE_URL=https://open.feishu.cn

# Base URL for the Feishu authorize endpoint a user's browser is sent to during `login`. Rarely
# needs changing.
SEEDAODB_CLIENT_FEISHU_AUTHORIZE_BASE_URL=https://accounts.feishu.cn

# Space-separated OAuth scopes requested during `login`. Must include offline_access, or Feishu
# will not issue a refresh_token and `login` will need to be rerun once the access token expires.
# Add any other scope your use of seedaodb's Feishu-backed endpoints requires.
SEEDAODB_CLIENT_FEISHU_SCOPE=offline_access

# Loopback port `login` binds to while waiting for the browser's authorization redirect (feishu
# mode, default flow -- not used with `login --manual`). Change this if the port is already in
# use, or to match a redirect URI you registered on a non-default port.
SEEDAODB_CLIENT_OAUTH_REDIRECT_PORT=8899

# Optional explicit override for the OAuth redirect URI. When unset, this client uses
# http://127.0.0.1:<SEEDAODB_CLIENT_OAUTH_REDIRECT_PORT>/callback. Whatever value is in effect
# must be registered exactly (scheme, host, port, and path) in the Feishu app's Security Settings.
SEEDAODB_CLIENT_FEISHU_REDIRECT_URI=

# Optional: path to lark-cli's run.js, used only by `whoami`'s best-effort, purely informational
# lark-cli identity cross-check. Leave blank to let this client search the same candidate
# locations the host project's own TypeScript tooling uses (see README.md's Windows section);
# also honored via the plain LARK_RUN environment variable if already set for other tools.
SEEDAODB_CLIENT_LARK_RUN=
