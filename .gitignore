thoughts/

# Claude Code local config (each developer brings their own; not part of the public repo)
.claude/
.claude

# Local runtime configs hold real Lark/org identifiers — keep only the *.example templates
configs/*.json
!configs/*.example
!configs/*.json.example

# Per-instance memory journals (live community interaction logs — not framework code)
workspaces/*/memory/journal/*.md

# Generated person-profile deliverables (interview outputs, may contain PII — not framework code)
workspaces/*/memory/profiles/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

