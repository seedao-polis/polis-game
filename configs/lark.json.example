{
  "version": 1,
  "larkRun": null,
  "profiles": {
    "default": {
      "larkProfile": "default",
      "appId": "cli_example_app_id",
      "tenantKey": "example_tenant_key",
      "userOpenId": "ou_example_operator",
      "botOpenId": "ou_example_bot",
      "botName": "城邦土地神"
    }
  },
  "knownInternalChats": {
    "工作群": "oc_example_work_group",
    "工作人员": "oc_example_staff_group",
    "市政厅工作群": "oc_example_cityhall_work_group",
    "运营小天地": "oc_example_ops_group",
    "城邦快报": "oc_example_broadcast_group",
    "围观群": "oc_example_public_group",
    "AgentTasks": "oc_example_agent_tasks",
    "AgentNotify": "oc_example_agent_notify"
  },
  "notifyChat": "AgentNotify",
  "discovery": {
    "mode": "all-internal",
    "refreshMinutes": 5
  },
  "event": {
    "key": "im.message.receive_v1"
  },
  "activityCalendarId": "feishu.cn_example_calendar_id@group.calendar.feishu.cn",
  "activityWikiNodeToken": "ExampleWikiNodeToken",
  "activityWikiDocId": "ExampleWikiDocId",
  "visitorMilestoneWikiNodeToken": "wikcnExampleVisitorNode",
  "visitorMilestoneWikiDocId": "doxcnExampleVisitorDoc",
  "badgeWikiNodeToken": "wikcnExampleBadgeNode",
  "badgeWikiDocId": "doxcnExampleBadgeDoc"
}